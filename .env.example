# Omega Education Centre ERP - Environment Configuration
# =====================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Supabase Configuration (Central Backend)
# Leave blank to run fully offline (SQLite-only mode)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Organisation Code (for multi-tenant scenarios)
# Default: ORG_OMEGA_DEFAULT
ORG_CODE=ORG_OMEGA_DEFAULT
